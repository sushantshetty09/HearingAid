<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- STATUS INDICATOR CARD -->
        <LinearLayout
            android:id="@+id/statusIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_indicator"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/pulse_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="System Active: High Fidelity"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- EMERGENCY CONTROL CARD -->
        <LinearLayout
            android:id="@+id/btnToggleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_section_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Emergency Control"
                android:textColor="@color/on_surface"
                android:textSize="22sp" />

            <FrameLayout
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_start_button"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_power"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvToggleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="STOP/START HEARING AID"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⚠️ Connect headphones to prevent loud feedback noise"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- SEGREGATED CARD 1: WAVEFORM OSCILLOSCOPE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#121D1D"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#3300E676"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_equalizer"
                        app:tint="#00E676" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Waveform Oscilloscope"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#2600E676"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="TIME DOMAIN"
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.example.hearingaidapp.WaveformView
                    android:id="@+id/waveformView"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />

                <!-- Waveform Manual Zoom Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Visual Zoom"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgWaveformZoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipZoom1x"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            app:chipMinTouchTargetSize="48dp"
                            android:contentDescription="Visual Zoom 1x"
                            android:checked="true"
                            android:text="1x"
                            android:textSize="10sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipZoom2x"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            app:chipMinTouchTargetSize="48dp"
                            android:contentDescription="Visual Zoom 2x"
                            android:text="2x"
                            android:textSize="10sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipZoom4x"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            app:chipMinTouchTargetSize="48dp"
                            android:contentDescription="Visual Zoom 4x"
                            android:text="4x"
                            android:textSize="10sp" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- MEETING RECORDER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meeting Recorder"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvRecordingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tap to record what you hear and replay later"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleRecording"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Record"
                    android:minWidth="100dp"
                    app:icon="@drawable/ic_mic"
                    app:cornerRadius="24dp"
                    style="?attr/materialButtonStyle" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SEGREGATED CARD 2: SPECTRUM ANALYZER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#121D1D"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#3300E5FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_analytics"
                        app:tint="#00E5FF" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Frequency Spectrum"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#2600E5FF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="48 BINS (60Hz - 16kHz)"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.example.hearingaidapp.SpectrumView
                    android:id="@+id/spectrumView"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2-COLUMN GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_info_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_noise_control"
                        app:tint="@color/primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Noise Cancel"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoiseCancelingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Active"
                    android:textColor="@color/primary"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1A000000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="MAX"
                    android:textColor="@color/primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_info_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_volume_up"
                        app:tint="@color/secondary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Gain"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGainValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="+12dB"
                    android:textColor="@color/secondary"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1A000000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="AUTO"
                    android:textColor="@color/secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PARAMETRIC EQ SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_section_card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_equalizer"
                    app:tint="@color/tertiary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Parametric EQ"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp" />

                <ImageButton
                    android:id="@+id/btnAddFilter"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_add_circle"
                    app:tint="@color/primary" />
            </LinearLayout>

            <!-- Preset Actions Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnLoadPreset"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Load"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSavePreset"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Save"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="Current: Custom"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:textStyle="italic" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_variant" />

            <LinearLayout
                android:id="@+id/filterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

            <TextView
                android:id="@+id/tvNoFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="No Filters"
                android:textColor="#888888" />
        </LinearLayout>

        <!-- HEARING PROFILE CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chipRestaurant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_restaurant"
                        app:tint="@color/on_primary" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Restaurant"
                        android:textColor="@color/on_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/on_surface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Home"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipOutdoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_nature_people"
                        app:tint="@color/on_surface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Outdoor"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ADVANCED FEATURES (hidden section or collapsed) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/advancedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_container"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/advancedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Advanced Features"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/advancedContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Switch
                        android:id="@+id/switchNoiseCanceling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Noise Canceling"
                        android:textColor="@color/on_surface" />

                    <ImageButton
                        android:id="@+id/btnNcInfo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Noise cancellation info"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="@color/primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoiseStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Active"
                    android:textColor="@color/on_surface" />

                <ProgressBar
                    android:id="@+id/pbNoiseLearning"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/spectrum_mid"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvNoiseStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Noise Strength: 50%"
                    android:textColor="@color/on_surface" />

                <SeekBar
                    android:id="@+id/seekBarNoiseStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:max="100" />

                <Button
                    android:id="@+id/btnResetNoiseProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Reset Noise Profile" />

                <TextView
                    android:id="@+id/tvNoiseGate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Noise Gate"
                    android:textColor="@color/on_surface" />

                <SeekBar
                    android:id="@+id/seekBarNoiseGate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvCompression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Compression"
                    android:textColor="@color/on_surface" />

                <SeekBar
                    android:id="@+id/seekBarCompression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvVolumeLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Master Volume"
                    android:textColor="@color/on_surface" />

                <SeekBar
                    android:id="@+id/seekBarVolume"
